# SCI-DOC AI Phase 11 staging configuration
APP_NAME=SCI-DOC AI
API_VERSION=v1
DEBUG=false

# Required application authentication settings.
SCI_DOC_API_KEY=replace-with-a-staging-api-key
SCI_DOC_TENANT_ID=staging-tenant

# Infrastructure credentials. Use a secret manager in shared environments.
POSTGRES_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=staging-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

# Keep lightweight providers for infrastructure-only staging verification.
OCR_PROVIDER=tesseract
TRANSLATION_PROVIDER=rule-based-dev
