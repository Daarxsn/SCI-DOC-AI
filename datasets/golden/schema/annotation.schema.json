{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"SCI-DOC Annotation",
  "type":"object",
  "required":["schema_version","case_id","annotations"],
  "properties":{
    "schema_version":{"type":"string"},
    "case_id":{"type":"string"},
    "annotations":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["annotation_id","annotation_type","page_number"],
        "properties":{
          "annotation_id":{"type":"string"},
          "annotation_type":{"enum":["document","text","equation","diagram","table","layout"]},
          "page_number":{"type":"integer","minimum":1},
          "element_id":{"type":["string","null"]},
          "source_text":{"type":["string","null"]},
          "target_text":{"type":["string","null"]},
          "bbox":{
            "type":["object","null"],
            "properties":{
              "x":{"type":"number"},"y":{"type":"number"},
              "width":{"type":"number"},"height":{"type":"number"}
            },
            "required":["x","y","width","height"]
          },
          "structured":{"type":"object"}
        }
      }
    }
  }
}
